<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 11 et antérieurs : ces règles s'appliquent à la fois à la sauvegarde cloud et au
    transfert entre appareils, sans moyen de les distinguer. Tout est exclu pour qu'aucune donnée
    ne parte vers Google Drive ; sur ces versions, utiliser l'export chiffré pour changer de téléphone.
-->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>

<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 12+.
    Sauvegarde cloud (Google Drive) désactivée : aucune donnée ne quitte le téléphone vers un tiers.
    Le transfert direct d'un téléphone à l'autre (câble / Wi-Fi local, à la configuration d'un
    nouvel appareil) reste autorisé.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="." />
        <include domain="file" path="datastore/" />
    </device-transfer>
</data-extraction-rules>
